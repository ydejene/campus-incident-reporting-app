rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isAuthenticated()
        && request.auth.token.email_verified == true;
    }

    function isEligibleALUEmail() {
      return isAuthenticated()
        && request.auth.token.email is string
        && (
          request.auth.token.email.matches('^[^@]+@alustudent[.]com$')
          || request.auth.token.email.matches('^[^@]+@alueducation[.]com$')
        );
    }

    function userDocExists() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isStudent() {
      return isEmailVerified()
        && isEligibleALUEmail()
        && userDocExists()
        && getUserRole() == 'student';
    }

    function isStaff() {
      return isEmailVerified()
        && isEligibleALUEmail()
        && userDocExists()
        && getUserRole() == 'staff';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // User profiles
    match /users/{uid} {
      allow read: if
        (isOwner(uid) && isEmailVerified() && isEligibleALUEmail())
        || isStaff();

      allow create: if isOwner(uid)
        && isEmailVerified()
        && isEligibleALUEmail()
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student'
        && request.resource.data.keys().hasAll(['uid', 'email', 'role'])
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'role',
          'createdAt', 'updatedAt'
        ]);

      allow update: if isOwner(uid)
        && isEmailVerified()
        && isEligibleALUEmail()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt']);

      allow delete: if false;
    }

    // Incident records
    match /incidents/{incidentId} {
      allow read: if isStudent() || isStaff();

      allow create: if isStudent()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'submitted';

      allow update: if isStaff()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);

      allow delete: if false;

      // Status history
      match /status_history/{historyId} {
        allow read: if isStudent() || isStaff();

        allow create: if isStaff()
          && request.resource.data.updatedBy == request.auth.uid
          && (
            request.resource.data.newStatus != 'rejected'
            || (
              request.resource.data.remarks is string
              && request.resource.data.remarks.size() > 0
            )
          );

        allow update, delete: if false;
      }

      // Private reporter information
      match /private/reporter {
        allow read: if isEmailVerified()
          && isEligibleALUEmail()
          && (
            (exists(/databases/$(database)/documents/incidents/$(incidentId))
              && get(/databases/$(database)/documents/incidents/$(incidentId)).data.createdBy == request.auth.uid)
            || isStaff()
          );

        allow create: if isStudent()
          && request.resource.data.createdBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/incidents/$(incidentId)).data.createdBy == request.auth.uid;

        allow update, delete: if false;
      }
    }
  }
}
